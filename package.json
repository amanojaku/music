{
  "name": "my-music",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate:audio": "tsx scripts/generate-sample-audio.ts",
    "test": "vitest run",
    "predev": "tsx scripts/generate-sample-audio.ts --if-missing && node scripts/copy-alphatab-assets.mjs",
    "transcribe": "tsx scripts/transcribe.ts",
    "prebuild": "node scripts/copy-alphatab-assets.mjs",
    "musescore": "tsx scripts/to-musescore.ts"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@spotify/basic-pitch": "^1.0.1",
    "@tailwindcss/postcss": "^4",
    "@tensorflow/tfjs": "^3.21.0",
    "@tensorflow/tfjs-backend-wasm": "^3.21.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "core-js": false
  }
}
